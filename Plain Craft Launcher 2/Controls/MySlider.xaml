<Border x:Class="PCL.MySlider"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:PCL.Core.UI.Controls;assembly=PCL.Core"
        FocusVisualStyle="{x:Null}" MinHeight="48" MinWidth="80"
        UseLayoutRounding="False" SnapsToDevicePixels="False"
        Name="PanBack" Background="Transparent" Focusable="True">
    <Grid x:Name="PanMain" ClipToBounds="False">
        <Grid x:Name="TrackLayer" Margin="30,0" Height="6" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border CornerRadius="3" Background="{DynamicResource Fluent.SliderTrack}" />
            <Border Name="LineFore" CornerRadius="3" Background="{DynamicResource Fluent.AccentFill}"
                    HorizontalAlignment="Left" Width="0" />
        </Grid>
        <glass:LiquidGlassSurface x:Name="ShapeDot" Material="SliderThumb" Width="40" Height="24"
                HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="12"
                Background="Transparent" BorderBrush="{DynamicResource Fluent.Stroke}" BorderThickness="1"
                IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <glass:LiquidGlassSurface.RenderTransform>
                <TransformGroup><ScaleTransform x:Name="ThumbScale"/><TranslateTransform x:Name="ThumbOffset"/></TransformGroup>
            </glass:LiquidGlassSurface.RenderTransform>
            <glass:LiquidGlassSurface.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05" />
            </glass:LiquidGlassSurface.Effect>
        </glass:LiquidGlassSurface>
        <Popup Name="Popup" AllowsTransparency="True" IsHitTestVisible="False" PopupAnimation="Fade"
               PlacementTarget="{Binding ElementName=PanMain}" Placement="Top" VerticalOffset="-8">
            <Border BorderBrush="{DynamicResource Fluent.Stroke}" BorderThickness="1" CornerRadius="8" MaxWidth="500"
                    Background="{DynamicResource Fluent.Surface}" Padding="9,6" Margin="4">
                <TextBlock Name="TextHint" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}" FontSize="12" />
            </Border>
        </Popup>
    </Grid>
</Border>
